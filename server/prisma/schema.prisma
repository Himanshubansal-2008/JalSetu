generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  WORKER
}

enum AssetType {
  SOURCE
  PUMP
  PIPELINE
  VALVE
  TANK
  TREATMENT_PLANT
  STANDPOST
}

enum AssetStatus {
  WORKING
  FAULTY
  UNDER_REPAIR
}

enum StockTxnType {
  IN
  OUT
}

enum LedgerType {
  RECEIPT
  EXPENSE
}

enum BillStatus {
  PENDING
  PAID
}

model GramPanchayat {
  id             String   @id @default(uuid())
  name           String
  village        String
  block          String?
  district       String
  state          String
  upiId          String?
  openingBalance Int      @default(0) // paise
  createdAt      DateTime @default(now())

  users     User[]
  assets    Asset[]
  items     InventoryItem[]
  ledger    LedgerEntry[]
  consumers Consumer[]
  bills     Bill[]
}

model User {
  id        String   @id @default(uuid())
  gpId      String
  name      String
  phone     String   @unique
  password  String
  role      Role     @default(WORKER)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  gp            GramPanchayat @relation(fields: [gpId], references: [id])
  assetEvents   AssetEvent[]
  stockTxns     StockTxn[]
  ledgerEntries LedgerEntry[]
}

model Asset {
  id             String      @id @default(uuid())
  gpId           String
  name           String
  type           AssetType
  status         AssetStatus @default(WORKING)
  lat            Float?
  lng            Float?
  installDate    DateTime?
  cost           Int?        // paise
  warrantyExpiry DateTime?
  attributes     Json?       // e.g. { "hp": 5, "capacityL": 10000 }
  notes          String?
  photo          String?     // base64 image
  createdAt      DateTime    @default(now())

  gp        GramPanchayat @relation(fields: [gpId], references: [id])
  events    AssetEvent[]
  ledger    LedgerEntry[]
  stockTxns StockTxn[]

  @@index([gpId])
}

model AssetEvent {
  id          String   @id @default(uuid())
  assetId     String
  createdById String
  kind        String   // REPAIR, INSPECTION, NOTE, STATUS_CHANGE
  note        String?
  photo       String?  // base64 image
  createdAt   DateTime @default(now())

  asset     Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  createdBy User  @relation(fields: [createdById], references: [id])
}

model InventoryItem {
  id           String   @id @default(uuid())
  gpId         String
  name         String
  unit         String   // kg, litre, piece
  quantity     Float    @default(0)
  reorderLevel Float    @default(0)
  createdAt    DateTime @default(now())

  gp   GramPanchayat @relation(fields: [gpId], references: [id])
  txns StockTxn[]

  @@index([gpId])
}

model StockTxn {
  id          String       @id @default(uuid())
  itemId      String
  type        StockTxnType
  quantity    Float
  assetId     String?
  note        String?
  createdById String
  createdAt   DateTime     @default(now())

  item      InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  asset     Asset?        @relation(fields: [assetId], references: [id])
  createdBy User          @relation(fields: [createdById], references: [id])
}

model LedgerEntry {
  id          String     @id @default(uuid())
  gpId        String
  type        LedgerType
  category    String     // GRANT, WATER_TAX, REPAIR, PURCHASE, ELECTRICITY, OTHER
  amount      Int        // PAISE, never float
  date        DateTime   @default(now())
  description String?
  mode        String?    // CASH, UPI, CHEQUE
  reference   String?
  voided      Boolean    @default(false)
  assetId     String?
  billId      String?    @unique
  createdById String
  createdAt   DateTime   @default(now())

  gp        GramPanchayat @relation(fields: [gpId], references: [id])
  asset     Asset?        @relation(fields: [assetId], references: [id])
  bill      Bill?         @relation(fields: [billId], references: [id])
  createdBy User          @relation(fields: [createdById], references: [id])

  @@index([gpId, date])
}

model Consumer {
  id            String   @id @default(uuid())
  gpId          String
  name          String
  houseNo       String
  phone         String?
  monthlyCharge Int      // PAISE
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())

  gp    GramPanchayat @relation(fields: [gpId], references: [id])
  bills Bill[]

  @@index([gpId])
}

model Bill {
  id         String     @id @default(uuid())
  gpId       String
  consumerId String
  month      String     // "2026-11"
  amount     Int        // PAISE
  status     BillStatus @default(PENDING)
  paidAt     DateTime?
  mode       String?
  reference  String?
  createdAt  DateTime   @default(now())

  gp       GramPanchayat @relation(fields: [gpId], references: [id])
  consumer Consumer      @relation(fields: [consumerId], references: [id])
  ledger   LedgerEntry?

  @@unique([consumerId, month])
  @@index([gpId, month])
}
