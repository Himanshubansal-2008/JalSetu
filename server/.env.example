# Database Connection (PostgreSQL - Neon / RDS / Supabase)
DATABASE_URL="postgresql://username:password@localhost:5432/jalsetu?schema=public"

# JWT Authentication Secret (generate with: openssl rand -base64 32)
JWT_SECRET="your_high_entropy_jwt_secret_min_32_characters"

# Server Port
PORT=4000

# Optional comma-separated CORS allowed origins (e.g. https://jalsetu.example.com,https://admin.jalsetu.example.com)
ALLOWED_ORIGINS=""

# Demo Mode (strictly false in production)
DEMO_MODE=false

# Platform Super Admin Bootstrap Configuration (used on initial boot or npm run bootstrap:super-admin)
MAIN_ADMIN_PHONE="9876543210"
MAIN_ADMIN_PASSWORD="ChangeMeInProduction123!"

# Optional Super Admin boot trigger (set to true to run bootstrap on app.listen)
RUN_SUPER_ADMIN_BOOTSTRAP=false

# Optional external secret key for headless API verification (header: x-superadmin-secret)
SUPERADMIN_SECRET=""
