{
  "expo": {
    "name": "JalSetu",
    "slug": "jalsetu",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B6BCB"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.jalsetu.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "JalSetu needs access to your photos to attach asset verification and receipt photos.",
          "cameraPermission": "JalSetu needs access to your camera to take asset verification photos on site."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "JalSetu needs access to your location to tag water supply asset GPS coordinates on site."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "feb21887-a6ea-43aa-ad7d-5f86aa007e6f"
      }
    },
    "owner": "himanshu_bansal"
  }
}
